{
  "expo": {
    "name": "Vetronix Employee",
    "slug": "vetronix-employee-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,

    "scheme": "vetronix",

    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vetronix.employee"
    },

    "android": {
      "package": "com.vetronix.employee",

      "versionCode": 1,

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },

      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,

      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
  "expo-location",
  {
    "isAndroidBackgroundLocationEnabled": true,
    "isAndroidForegroundServiceEnabled": true,
    "locationAlwaysAndWhenInUsePermission": "Allow Vetronix Employee to access your location while you are working, including when the app is in the background."
  }
]
    ],

    "extra": {
      "eas": {
        "projectId": "5db925db-a2e8-49e5-9e44-0be1e6626761"
      }
    },

    "owner": "shramik"
  }
}